<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="续航助手" Width="1180" Height="790" MinWidth="970" MinHeight="670" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Background="Transparent" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#20232B" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#515C6B"/>
  <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0.75,1"><GradientStop Color="#BBFFFFFF" Offset="0"/><GradientStop Color="#65FFFFFF" Offset="1"/></LinearGradientBrush>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Glass}"/><Setter Property="BorderBrush" Value="#DFFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Padding" Value="22"/></Style>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#AFFFFFFF"/><Setter Property="Foreground" Value="#252B37"/><Setter Property="Padding" Value="18,10"/><Setter Property="BorderBrush" Value="#EFFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="40"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.62"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#007AFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#007AFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#508FCFFF"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="16,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Track" Width="40" Height="24" Background="#BDC6D1" CornerRadius="12"><Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#34C759"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="RadioButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tile" CornerRadius="11" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="#EEFFFFFF"/><Setter Property="Foreground" Value="#007AFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#BBFFFFFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#727987"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#20808080"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#24007AFF"/><Setter Property="Foreground" Value="#20232B"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid x:Name="Root" Background="#28F0F5FF" Margin="10">
  <Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border CornerRadius="28" Background="#55FFFFFF" BorderBrush="#DAFFFFFF" BorderThickness="1" Margin="6,6,12,6" Padding="12,24">
   <Grid><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
    <StackPanel Margin="13,7,0,0"><TextBlock Text="续航助手" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="BATTERY PILOT" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel>
    <Grid Grid.Row="1" VerticalAlignment="Top"><Border x:Name="NavIndicator" Height="48" VerticalAlignment="Top" Background="{StaticResource Glass}" BorderBrush="#F8FFFFFF" BorderThickness="1" CornerRadius="24"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border><StackPanel>
     <Button x:Name="Nav0" Style="{StaticResource Nav}" Content="⌂    概览" Margin="0,0,0,8"/>
     <Button x:Name="Nav1" Style="{StaticResource Nav}" Content="▥    进程活动" Margin="0,0,0,8"/>
     <Button x:Name="Nav2" Style="{StaticResource Nav}" Content="⚙    电源策略" Margin="0,0,0,8"/>
     <Button x:Name="Nav3" Style="{StaticResource Nav}" Content="ⓘ    设备信息"/>
    </StackPanel></Grid>
    <StackPanel Grid.Row="2"><Button x:Name="TrayButton" Content="收起到托盘"/><TextBlock Text="v3.1.0 · 本地运行" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="20,13,18,10"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
   <Grid x:Name="Header"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions><TextBlock x:Name="PageTitle" Text="电量与续航" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="StateText" Grid.Column="1" Text="● 仅监测" Foreground="#007AFF" VerticalAlignment="Center" Margin="10,0,8,0"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="MinimizeButton" Content="−" Width="34" Height="34" MinHeight="34" Padding="0" Margin="6,0"/><Button x:Name="CloseButton" Content="×" Width="34" Height="34" MinHeight="34" Padding="0"/></StackPanel></Grid>
   <Grid x:Name="Pages" Grid.Row="1" Margin="0,12,0,0">
    <Grid x:Name="OverviewPage"><Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="*"/><RowDefinition Height="104"/><RowDefinition Height="58"/></Grid.RowDefinitions>
     <UniformGrid Columns="4"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="剩余电量" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="Charge" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock x:Name="PowerSource" Text="读取电池中" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="整机放电功率" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="Watts" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="电池传感器 · 整机" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="预估剩余时间" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="Remaining" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="基于近期功耗估算" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="近 5 分钟平均" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="Average" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock x:Name="Samples" Text="等待连续样本" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></Border></UniformGrid>
     <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="放电趋势" FontSize="15" FontWeight="SemiBold"/><Grid x:Name="ChartHost" Grid.Row="1"/></Grid></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="值得留意的进程" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="TopProcesses" Text="正在建立采样基线…" Margin="0,12,0,0"/></StackPanel></Border>
     <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="StartButton" Content="开启均衡调度" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button x:Name="StopButton" Content="停止并恢复" Margin="0,0,10,0"/><Button x:Name="ExportButton" Content="导出本次记录"/></StackPanel>
    </Grid>
    <Grid x:Name="ProcessPage" Visibility="Hidden"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="185" Height="36" VerticalAlignment="Center" ToolTip="搜索进程名称或 PID"/><Border CornerRadius="14" Background="#50818BA1" Padding="3" Margin="12,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="SortCpu" Content="CPU" GroupName="Sort" IsChecked="True"/><RadioButton x:Name="SortMemory" Content="内存" GroupName="Sort"/><RadioButton x:Name="SortIo" Content="I/O" GroupName="Sort"/></StackPanel></Border><CheckBox x:Name="GroupProcesses" Content="合并同名进程" IsChecked="True" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Text="资源活动可帮助定位耗电来源，不代表每个进程的真实瓦数。&#10;CPU 按整机归一；I/O 含文件、网络等读写；内存工作集合并可能重复计入共享页。不含 GPU 活动。"/>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12"><DataGrid x:Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#12808080" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#16FFFFFF" BorderThickness="0" RowHeight="34" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"><DataGrid.Columns><DataGridTextColumn Header="程序 / 进程" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="PID / 数量" Binding="{Binding IdText}" Width="1.1*"/><DataGridTextColumn Header="CPU %" Binding="{Binding CpuText}" Width="*"/><DataGridTextColumn Header="内存 MB" Binding="{Binding MemoryText}" Width="*"/><DataGridTextColumn Header="I/O MB/s" Binding="{Binding IoText}" Width="*"/><DataGridTextColumn Header="活动提示" Binding="{Binding Activity}" Width="1.1*"/></DataGrid.Columns></DataGrid></Border>
     <Grid Grid.Row="3" Margin="0,8,0,0"><TextBlock x:Name="ProcessSummary" Text="正在采样" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="TaskManagerButton" Content="任务管理器" HorizontalAlignment="Right" Padding="14,5" MinHeight="32"/></Grid>
    </Grid>
    <Border x:Name="PolicyPage" Visibility="Hidden" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="日常电池模式" FontSize="15" FontWeight="SemiBold"/><Border Background="#307B8DA0" CornerRadius="16" Padding="4" Margin="0,14,0,24" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><RadioButton x:Name="Mode0" Content="流畅优先" GroupName="Mode"/><RadioButton x:Name="Mode1" Content="均衡续航" GroupName="Mode" IsChecked="True"/><RadioButton x:Name="Mode2" Content="续航优先" GroupName="Mode"/></StackPanel></Border>
     <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="闲置关屏时间 / 分钟" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ScreenMinus" Content="−" Width="38" Padding="0"/><TextBlock x:Name="ScreenValue" Text="5" Width="64" TextAlignment="Center" VerticalAlignment="Center"/><Button x:Name="ScreenPlus" Content="+" Width="38" Padding="0"/></StackPanel></Grid>
     <CheckBox x:Name="AutoLow" Content="低电量时自动加强节能" IsChecked="True" Margin="0,0,0,24"/>
     <Grid Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock Text="低电量阈值 / %" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="LowMinus" Content="−" Width="38" Padding="0"/><TextBlock x:Name="LowValue" Text="20" Width="64" TextAlignment="Center" VerticalAlignment="Center"/><Button x:Name="LowPlus" Content="+" Width="38" Padding="0"/></StackPanel></Grid>
     <TextBlock Text="插电自动恢复原方案。低电量时最多闲置 2 分钟关屏。&#10;电量回升至阈值 + 5% 后回到日常模式。CPU 峰值设置保持原值。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,24"/>
     <Button x:Name="SaveButton" Content="保存并应用" Style="{StaticResource Primary}" HorizontalAlignment="Left"/><Separator Margin="0,26,0,20" Background="#20808080"/>
     <TextBlock Text="界面与材质" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,18"/><CheckBox x:Name="GlassEnabled" Content="系统 Acrylic 背景模糊" IsChecked="True" Margin="0,0,0,16"/><CheckBox x:Name="MotionEnabled" Content="短时切换动效" IsChecked="True"/><TextBlock Text="材质由 Windows 合成器处理；系统节能或关闭透明效果时可能使用实色。关闭窗口会恢复电源设置，后台运行请收起到托盘。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,20,0,0"/>
    </StackPanel></ScrollViewer></Border>
    <Grid x:Name="DevicePage" Visibility="Hidden"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="DeviceName" Text="正在读取设备信息…" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="DeviceHardware" Margin="0,22,0,0" FontSize="14" Text="硬件信息正在加载"/><TextBlock x:Name="DeviceSystem" Margin="0,12,0,0" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DeviceBattery" Margin="0,24,0,0" Text="电池信息正在加载"/><TextBlock x:Name="CompatibilityInfo" Margin="0,24,0,0" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RenderInfo" Margin="0,20,0,0" Foreground="{StaticResource Muted}"/><TextBlock Text="设备与电池数据均在本机读取，不会上传。系统、固件或权限未提供的字段会显示为不可用。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/></StackPanel></Border><StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="ReportButton" Content="生成最新电池报告" Margin="0,0,10,0"/><Button x:Name="SettingsButton" Content="Windows 电源设置"/></StackPanel></Grid>
   </Grid>
   <TextBlock x:Name="Footer" Grid.Row="2" Text="正在读取本机数据…" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Bottom"/>
  </Grid>
 </Grid>
</Window>

